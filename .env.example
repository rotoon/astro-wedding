# Guestbook (/wishes) — Firebase web config. These values are public by design
# (they end up in the browser bundle); access is controlled by firebase/*.rules.
# Copy from the old wedding-wish-next Vercel project (NEXT_PUBLIC_FIREBASE_* → PUBLIC_FIREBASE_*).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Local development only: use the Firebase emulators
# (npx firebase-tools emulators:start --only firestore,storage --project demo-wedding)
# PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
