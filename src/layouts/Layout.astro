---
import '../styles/global.css'
import {
  ceremony,
  couple,
  coupleNames,
  dateDisplay,
  site,
  venue,
} from '../data/wedding'

interface Props {
  title?: string
  description?: string
}

const {
  title = `${couple.title} | Just Married · ${dateDisplay.long}`,
  description = `${couple.bride.name} (${couple.bride.nickname}) & ${couple.groom.name} (${couple.groom.nickname}) were married on ${dateDisplay.long} at ${venue.shortName}. Relive the day, watch the film and leave us a wish.`,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, site.url).href
const ogImageUrl = new URL(site.ogImage, site.url).href
const ogImageAlt = `${couple.title} ${couple.tagline} ${dateDisplay.dashed}`
const buildTime = new Date().toISOString()

// Social / SEO meta tags, rendered in this order
const metaTags = [
  { name: 'title', content: title },
  { name: 'description', content: description },
  {
    name: 'keywords',
    content: `wedding, wedding invitation, ${couple.bride.thaiName}, ${couple.groom.thaiName}, wedding chiangmai, virgin ville, sanpatong`,
  },
  { name: 'author', content: coupleNames },

  // Open Graph / Facebook
  { property: 'og:type', content: 'website' },
  { property: 'og:url', content: canonicalURL },
  { property: 'og:title', content: title },
  { property: 'og:description', content: description },
  { property: 'og:image', content: ogImageUrl },
  { property: 'og:locale', content: 'th_TH' },
  { property: 'og:site_name', content: site.name },
  { property: 'og:image:width', content: '1200' },
  { property: 'og:image:height', content: '600' },
  { property: 'og:image:alt', content: ogImageAlt },
  { property: 'og:updated_time', content: buildTime },
  { property: 'article:published_time', content: buildTime },

  // LINE
  { property: 'line:image', content: ogImageUrl },
  { property: 'line:title', content: title },
  { property: 'line:description', content: description },

  // Twitter
  { name: 'twitter:card', content: 'summary_large_image' },
  { name: 'twitter:url', content: canonicalURL },
  { name: 'twitter:title', content: title },
  { name: 'twitter:description', content: description },
  { name: 'twitter:image', content: ogImageUrl },
  { name: 'twitter:image:alt', content: ogImageAlt },
  { name: 'twitter:creator', content: site.twitterHandle },
  { name: 'twitter:site', content: site.twitterHandle },

  // Mobile
  { name: 'theme-color', content: site.themeColor },
  { name: 'mobile-web-app-capable', content: 'yes' },
  { name: 'apple-mobile-web-app-capable', content: 'yes' },
  { name: 'apple-mobile-web-app-status-bar-style', content: 'default' },
  { name: 'format-detection', content: 'telephone=no' },
]

// Event structured data - serialized with JSON.stringify so values are escaped
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `Wedding of ${coupleNames}`,
  startDate: ceremony.start,
  endDate: ceremony.end,
  location: {
    '@type': 'Place',
    name: venue.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: venue.address.street,
      addressLocality: venue.address.locality,
      addressRegion: venue.address.region,
      postalCode: venue.address.postalCode,
      addressCountry: venue.address.country,
    },
  },
  image: [
    ogImageUrl,
    new URL('/img/hero.webp', site.url).href,
    new URL(couple.bride.photo, site.url).href,
  ],
  description: ogImageAlt,
  organizer: {
    '@type': 'Person',
    name: coupleNames,
  },
}

const fontsUrl =
  'https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400;500;600&family=Cinzel:wght@400;500&family=Montserrat:wght@300;400;500&family=Playfair+Display:wght@400;500&family=Prompt:wght@300;400;500&display=swap'
---

<!doctype html>
<html lang='th'>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1.0'
    />
    <link
      rel='icon'
      type='image/x-icon'
      href='/favicon.ico'
    />
    <link
      rel='apple-touch-icon'
      href='/icons/apple-touch-icon.png'
    />
    <title>{title}</title>
    {metaTags.map((tag) => <meta {...tag} />)}
    <link
      rel='canonical'
      href={canonicalURL}
    />
    <link
      rel='manifest'
      href='/manifest.json'
    />

    <!-- Event Structured Data for SEO -->
    <script
      type='application/ld+json'
      set:html={JSON.stringify(eventSchema)}
    />

    <!-- Resource hints for better performance -->
    <link
      rel='preconnect'
      href='https://fonts.googleapis.com'
    />
    <link
      rel='preconnect'
      href='https://fonts.gstatic.com'
      crossorigin
    />

    <!-- Hero image is the first thing guests see; fetch it before the CSS asks for it -->
    <link
      rel='preload'
      as='image'
      href='/img/hero.webp'
      fetchpriority='high'
    />

    <!-- Critical CSS for faster rendering -->
    <style is:inline>
      /* Critical styles to avoid layout shifts */
      body {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        font-family: 'Montserrat', sans-serif;
      }
      body.loaded {
        overflow-y: auto;
      }
      .loading-screen {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #f6f1ed;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        opacity: 1;
        visibility: visible;
        transition:
          opacity 0.8s cubic-bezier(0.65, 0, 0.35, 1),
          visibility 0.8s cubic-bezier(0.65, 0, 0.35, 1);
        will-change: opacity, visibility;
      }
      .loading-screen.hidden {
        opacity: 0;
        visibility: hidden;
      }
      .main-container {
        opacity: 0;
        transition: opacity 0.8s cubic-bezier(0.33, 1, 0.68, 1);
        will-change: opacity;
      }
      .main-container.visible {
        opacity: 1;
      }
    </style>

    <!-- Optimized font loading - display=swap ensures text remains visible during font loading -->
    <link
      href={fontsUrl}
      rel='stylesheet'
      media='print'
      onload="this.setAttribute('media', 'all')"
    />
    <!-- Font fallback in case the above doesn't load -->
    <noscript>
      <link
        href={fontsUrl}
        rel='stylesheet'
      />
    </noscript>
  </head>
  <body>
    <div class='noise-overlay'></div>
    <slot />

    <script>
      import '../scripts/reveal'
    </script>
  </body>
</html>
