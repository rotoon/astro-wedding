---
import Layout from '../layouts/Layout.astro'
import LoadingAnimation from '../components/LoadingAnimation.astro'
import HeroSection from '../components/HeroSection.astro'
import MusicPlayer from '../components/MusicPlayer.astro'
import Bio from '../components/Bio.astro'
import PhotoGallery from '../components/PhotoGallery.astro'
import PhotoMosaic from '../components/PhotoMosaic.astro'
import HighlightVideo from '../components/HighlightVideo.astro'
import TogetherFor from '../components/TogetherFor.astro'
import ThankYou from '../components/ThankYou.astro'
import WishesWall from '../components/WishesWall.astro'
import Map from '../components/Map.astro'
import Footer from '../components/Footer.astro'
---

<Layout>
  <LoadingAnimation />
  <MusicPlayer />
  <div class='main-container'>
    <HeroSection />
    <div class='invitation-content'>
      <Bio />
      <PhotoGallery
        folder='img/slide'
        title='Our Love Story'
      />
      <PhotoMosaic />
      <!-- Shown once photos are added to public/img/wedding-day -->
      <PhotoGallery
        folder='img/wedding-day'
        title='Our Wedding Day'
        shuffled={false}
      />
      <!-- Shown once afterWedding.highlightVideoId is set in src/data/wedding.ts -->
      <HighlightVideo />
      <TogetherFor />
      <ThankYou />
      <WishesWall />
      <Map />
      <Footer />
    </div>
  </div>
</Layout>
