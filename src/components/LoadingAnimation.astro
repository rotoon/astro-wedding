---
import { couple } from '../data/wedding'
---

<div class='loading-screen'>
  <div class='loading-container'>
    <div class='loading-logo'>{couple.title}</div>
    <div class='loading-bar-container'>
      <div class='loading-bar'></div>
    </div>
    <div class='loading-text'>LOADING OUR LOVE STORY</div>
    <div
      class='loading-progress'
      id='loading-progress'
    >
      <span
        class='loading-percent'
        id='loading-percent'
        >0%</span
      >
    </div>
  </div>
</div>

<style>
  /* Prevent scroll during loading */
  :global(body.loading) {
    overflow: hidden;
    height: 100vh;
  }
</style>

<script>
  import { markIntroDone } from '../scripts/intro'

  // Show the intro for at least MIN_LOADING_TIME, wait for the hero image,
  // but never keep guests waiting longer than MAX_LOADING_TIME
  const MIN_LOADING_TIME = 1500
  const MAX_LOADING_TIME = 3000
  const PROGRESS_INTERVAL = 100 // Update the percentage every 100ms
  const PROGRESS_INCREMENT = 100 / (MIN_LOADING_TIME / PROGRESS_INTERVAL)
  const FADE_DELAY = 300 // Let the loading screen start fading before showing content

  const percentElement = document.getElementById('loading-percent')
  const loadingScreen = document.querySelector('.loading-screen')
  const mainContainer = document.querySelector('.main-container')

  let progress = 0
  let heroReady = false
  let minTimeElapsed = false
  let hidden = false

  const scrollToTop = () => window.scrollTo({ top: 0, left: 0, behavior: 'instant' })

  const updateProgress = () => {
    if (hidden) return

    // Hold at 95% until the hero image is ready
    progress = Math.min(progress + PROGRESS_INCREMENT, heroReady ? 100 : 95)
    if (percentElement) percentElement.textContent = `${Math.round(progress)}%`

    setTimeout(updateProgress, PROGRESS_INTERVAL)
  }

  const hideLoadingScreen = () => {
    if (hidden) return
    hidden = true

    if (percentElement) percentElement.textContent = '100%'
    loadingScreen?.classList.add('hidden')

    setTimeout(() => {
      mainContainer?.classList.add('visible')
      document.body.classList.remove('loading')
      document.body.classList.add('loaded')
      scrollToTop()
      markIntroDone()
    }, FADE_DELAY)
  }

  const maybeHide = () => {
    if (heroReady && minTimeElapsed) hideLoadingScreen()
  }

  // Prevent scrolling during loading
  document.body.classList.add('loading')
  scrollToTop()

  // The hero is preloaded in <head>, so this usually resolves from cache
  const hero = new Image()
  hero.src = '/img/hero.webp'
  hero
    .decode()
    .catch(() => {})
    .then(() => {
      heroReady = true
      maybeHide()
    })

  setTimeout(() => {
    minTimeElapsed = true
    maybeHide()
  }, MIN_LOADING_TIME)

  // Failsafe: never block the page longer than MAX_LOADING_TIME
  setTimeout(hideLoadingScreen, MAX_LOADING_TIME)

  updateProgress()
</script>
