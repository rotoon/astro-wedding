---
import { couple } from '../data/wedding'

// Groom first, then bride; photoPosition is the background focal point
const bioData = [
  { ...couple.groom, photoPosition: 'center', className: 'groom-card' },
  { ...couple.bride, photoPosition: 'top', className: 'bride-card' },
]
---

<!-- Couple Bio Section -->
<section class='bio-section'>
  <div class='section-decorative-line'></div>
  <div class='content-wrapper'>
    <div class='bio-heading'>
      <h2 class='section-title reveal-title'>About Us</h2>
    </div>
    <div class='bio-content'>
      <div class='bio-cards'>
        {
          bioData.map((bio, index) => (
            <>
              <div class={`bio-card ${bio.className} reveal-item`}>
                <div
                  class='bio-photo'
                  role='img'
                  aria-label={`Photo of ${bio.name}`}
                  style={`
                  background-image: url('${bio.avatar}');
                  background-size: cover;
                  background-position: ${bio.photoPosition};
                `}
                />
                <div class='bio-info'>
                  <h3>{bio.name}</h3>
                  <p class='bio-birthday'>{bio.birthday}</p>
                  <p class='bio-detail'>{bio.description}</p>
                </div>
              </div>
              {index === 0 && (
                <div class='bio-separator reveal-item'>
                  <div class='bio-heart'>❤</div>
                </div>
              )}
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>

