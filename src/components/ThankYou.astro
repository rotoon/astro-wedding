---
import { afterWedding, dateDisplay, venue } from '../data/wedding'

const { thankYou } = afterWedding
---

<!-- Thank-you note from the couple, with a recap of the day -->
<section class='details-section'>
  <div class='details-container'>
    <div class='details-heading'>
      <div class='section-decorative-line'></div>
      <h2 class='section-title reveal-title'>{thankYou.title}</h2>
      <p class='details-date reveal-item'>{dateDisplay.full}</p>
    </div>
    <div class='details-card'>

      <div class='thank-you-message reveal-item'>
        {thankYou.message.map((paragraph) => <p>{paragraph}</p>)}
        <p class='thank-you-signature'>{thankYou.signature}</p>
      </div>

      <div class='details-grid'>
        <div class='detail-item venue reveal-item'>
          <div class='detail-icon'>
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.5'
              stroke-linecap='round'
              stroke-linejoin='round'
            >
              <path d='M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z'></path>
              <circle
                cx='12'
                cy='10'
                r='3'
              ></circle>
            </svg>
          </div>
          <div class='detail-content'>
            <h3 class='detail-subtitle'>Where</h3>
            <p class='detail-text'>{venue.name}</p>
            <p class='detail-subtext'>Where it all began</p>
          </div>
        </div>

        <div class='detail-item time reveal-item'>
          <div class='detail-icon'>
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.5'
              stroke-linecap='round'
              stroke-linejoin='round'
            >
              <circle
                cx='12'
                cy='12'
                r='10'
              ></circle>
              <polyline points='12 6 12 12 16 14'></polyline>
            </svg>
          </div>
          <div class='detail-content'>
            <h3 class='detail-subtitle'>When</h3>
            <p class='detail-text'>{dateDisplay.time}</p>
            <p class='detail-subtext'>The morning we said “I do”</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
