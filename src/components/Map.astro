---
import { venue } from '../data/wedding'
---

<!-- Where the wedding took place (a keepsake now, so no directions button) -->
<section class='map-section'>
  <div class='map-container'>
    <div class='section-decorative-line'></div>
    <h2 class='section-title map-title reveal-title'>Where We Said “I Do”</h2>
    <div class='map-frame'>
      <div class='map-placeholder'>
        <div class='map-pin'></div>
        <div class='map-info'>
          <h3>{venue.name}</h3>
          <p>{venue.fullAddress}</p>
        </div>
      </div>
    </div>
  </div>
</section>
