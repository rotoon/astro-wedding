---
import { directionsUrl, venue } from '../data/wedding'
---

<!-- Map Section -->
<section class='map-section'>
  <div class='map-container'>
    <h2 class='map-title reveal-title'>Where We Said “I Do”</h2>
    <div class='map-frame'>
      <div class='map-placeholder'>
        <div class='map-pin'></div>
        <div class='map-info'>
          <h3>{venue.name}</h3>
          <p>{venue.fullAddress}</p>
          <a
            class='map-nav-btn'
            href={directionsUrl}
            target='_blank'
            rel='noopener noreferrer'>Get Directions</a
          >
        </div>
      </div>
    </div>
  </div>
</section>
