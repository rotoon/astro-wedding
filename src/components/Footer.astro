---
import { couple, coupleNames, dateDisplay } from '../data/wedding'
---

<footer class='wedding-footer'>
  <div class='footer-decorative-border'></div>
  <div class='footer-content'>
    <div class='footer-logo'>{couple.title}</div>
    <div class='footer-date'>{dateDisplay.dotted}</div>
    <div class='footer-text'>Thank you for celebrating with us!</div>
    <div class='footer-names'>{coupleNames}</div>
  </div>
</footer>
