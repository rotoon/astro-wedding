---
import { couple } from '../data/wedding'
import { listPublicImages, shuffle } from '../utils/images'

interface Props {
  /** Folder under public/ whose images become slides */
  folder: string
  title: string
  /** New random order on each build (default) or file-name order */
  shuffled?: boolean
  /** Show at most this many slides (after shuffling: a different set each build) */
  limit?: number
}

const { folder, title, shuffled = true, limit } = Astro.props
const images = listPublicImages(folder)
const galleryImages = (shuffled ? shuffle(images) : images).slice(0, limit)
---

<!-- Photo Gallery (rendered only when the folder has images) -->
{
  galleryImages.length > 0 && (
    <section class='gallery-section'>
      <div class='gallery-heading'>
        <div class='section-decorative-line'></div>
        <h2 class='section-title gallery-title reveal-title'>{title}</h2>
      </div>

      <div class='swiper-container'>
        <div class='swiper-wrapper'>
          {
            galleryImages.map((src, index) => (
              <div class='swiper-slide'>
                <div class='gallery-image'>
                  <img
                    src={src}
                    alt={`${couple.bride.nickname} & ${couple.groom.nickname}, ${title}, photo ${index + 1} of ${galleryImages.length}`}
                    loading='lazy'
                    decoding='async'
                  />
                </div>
              </div>
            ))
          }
        </div>
        <div class='swiper-pagination'></div>
      </div>
      <div class='gallery-controls'>
        <div class='swiper-button-prev'></div>
        <div class='swiper-button-next'></div>
      </div>
    </section>
  )
}

<script>
  import 'swiper/css'
  import 'swiper/css/navigation'
  import 'swiper/css/pagination'

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches

  // One Swiper per gallery section, each with its own arrows and dots. Swiper is
  // downloaded and set up only when a gallery nears the screen, so it doesn't
  // compete with the hero and the loading screen.
  const initGallery = async (section: HTMLElement) => {
    const container = section.querySelector<HTMLElement>('.swiper-container')
    if (!container) return

    const [{ default: Swiper }, { A11y, Autoplay, Navigation, Pagination }] =
      await Promise.all([import('swiper'), import('swiper/modules')])

    new Swiper(container, {
      modules: [A11y, Autoplay, Navigation, Pagination],
      grabCursor: true,
      slidesPerView: 1,
      spaceBetween: 20,
      // Swiper switches the nearest lazy images to eager so slides are ready before they appear
      lazyPreloadPrevNext: 2,
      pagination: {
        el: section.querySelector<HTMLElement>('.swiper-pagination'),
        clickable: true,
      },
      navigation: {
        nextEl: section.querySelector<HTMLElement>('.swiper-button-next'),
        prevEl: section.querySelector<HTMLElement>('.swiper-button-prev'),
      },
      a11y: {
        prevSlideMessage: 'Previous photo',
        nextSlideMessage: 'Next photo',
      },
      breakpoints: {
        768: {
          slidesPerView: 2,
          spaceBetween: 20,
        },
        992: {
          slidesPerView: 3,
          spaceBetween: 30,
        },
        1440: {
          slidesPerView: 4,
          spaceBetween: 30,
        },
        1600: {
          slidesPerView: 5,
          spaceBetween: 30,
        },
      },
      autoplay: prefersReducedMotion
        ? false
        : {
            delay: 3000,
            disableOnInteraction: false,
            pauseOnMouseEnter: true,
          },
    })
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        observer.unobserve(entry.target)
        initGallery(entry.target as HTMLElement)
      }
    },
    { rootMargin: '800px 0px' }
  )
  document
    .querySelectorAll<HTMLElement>('.gallery-section')
    .forEach((section) => observer.observe(section))
</script>
