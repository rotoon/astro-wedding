---
import fs from 'node:fs'
import path from 'node:path'

// Types
interface MosaicImage {
  filename: string
  path: string
}

// Utils
const getMosaicImages = (): MosaicImage[] => {
  const sweetDir = path.join(process.cwd(), 'public/img/sweet')

  if (!fs.existsSync(sweetDir)) {
    return []
  }

  // Numbered .webp files, sorted numerically (1, 2, ... 10) so the grid layout classes match
  return fs
    .readdirSync(sweetDir)
    .filter((filename) => filename.endsWith('.webp') && /\d+/.test(filename))
    .sort((a, b) => {
      const numA = Number.parseInt(a.match(/\d+/)?.[0] || '0', 10)
      const numB = Number.parseInt(b.match(/\d+/)?.[0] || '0', 10)
      return numA - numB
    })
    .map((filename) => ({
      filename: filename.replace(/\.\w+$/, ''),
      path: `/img/sweet/${filename}`,
    }))
}

const mosaicImages = getMosaicImages()
---

<!-- Photo Mosaic -->
<section class='photo-mosaic-section'>
  <div class='section-decorative-line'></div>
  <h2 class='section-title reveal-title'>Sweet Moments</h2>
  <div class='photo-mosaic'>
    {
      mosaicImages.map((image, index) => (
        <div
          class={`mosaic-item item${image.filename}`}
          data-image-path={image.path}
          role='button'
          tabindex='0'
          aria-label={`Open photo ${index + 1} of ${mosaicImages.length}`}
        >
          <img
            class='mosaic-image'
            src={image.path}
            alt=''
            loading='lazy'
            decoding='async'
            style='background-color: #eee;'
          />
        </div>
      ))
    }
  </div>
</section>

<!-- All styles have been moved to global.css -->

<script>
  // Constants
  const ANIMATION_CONFIG = {
    THRESHOLD: 0.1,
    ROOT_MARGIN: '10px 0px',
  } as const

  // Animation Setup
  const setupAnimations = (): void => {
    const items = document.querySelectorAll<HTMLElement>('.mosaic-item')

    if (!('IntersectionObserver' in window)) {
      items.forEach((item) => item.classList.add('visible'))
      return
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return

          const item = entry.target as HTMLElement
          requestAnimationFrame(() => item.classList.add('visible'))
          observer.unobserve(item)
        })
      },
      {
        threshold: ANIMATION_CONFIG.THRESHOLD,
        rootMargin: ANIMATION_CONFIG.ROOT_MARGIN,
      }
    )

    items.forEach((item) => observer.observe(item))
  }

  // Hover Effects
  const setupHoverEffects = (): void => {
    let activeItem: HTMLElement | null = null
    const mosaic = document.querySelector('.photo-mosaic')

    if (!mosaic) return

    mosaic.addEventListener('mouseover', (e: Event) => {
      const item = (e.target as HTMLElement).closest<HTMLElement>('.mosaic-item')

      if (item && activeItem !== item) {
        activeItem?.classList.remove('hover')
        item.classList.add('hover')
        activeItem = item
      }
    })

    mosaic.addEventListener('mouseleave', () => {
      activeItem?.classList.remove('hover')
      activeItem = null
    })
  }

  const createModal = (): HTMLElement => {
    const existing = document.querySelector<HTMLElement>('.image-modal')
    if (existing) return existing

    const modalHTML = `
      <div class="image-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="image-modal-backdrop"></div>
        <div class="image-modal-content">
          <div class="image-modal-header">
            <h3 id="modal-title" class="image-modal-title">Photo View</h3>
            <button
              class="image-modal-close"
              aria-label="Close modal"
              title="Close (Esc)"
            >
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="image-modal-loading" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:#fff;font-size:14px;">Loading...</div>
          <button class="image-modal-nav image-modal-prev" aria-label="Previous image">&lt;</button>
          <button class="image-modal-nav image-modal-next" aria-label="Next image">&gt;</button>
          <img class="image-modal-image" src="" alt="" style="opacity:0;transition:opacity 0.3s ease;">
          <div class="image-modal-footer">
            <button class="image-modal-btn image-modal-close-btn" aria-label="Close">Close</button>
          </div>
        </div>
      </div>
    `
    document.body.insertAdjacentHTML('beforeend', modalHTML)
    return document.querySelector<HTMLElement>('.image-modal')!
  }

  // Image modal setup function
  const setupImageModal = (): void => {
    const modal = createModal()

    const modalImage =
      modal.querySelector<HTMLImageElement>('.image-modal-image')
    const modalTitle =
      modal.querySelector<HTMLHeadingElement>('.image-modal-title')
    const modalClose =
      modal.querySelector<HTMLButtonElement>('.image-modal-close')
    const modalCloseBtn = modal.querySelector<HTMLButtonElement>(
      '.image-modal-close-btn'
    )
    const modalBackdrop = modal.querySelector<HTMLDivElement>(
      '.image-modal-backdrop'
    )
    const prevButton = modal.querySelector<HTMLButtonElement>('.image-modal-prev')
    const nextButton = modal.querySelector<HTMLButtonElement>('.image-modal-next')
    const loadingElement = modal.querySelector<HTMLElement>(
      '.image-modal-loading'
    )

    if (
      !modalImage ||
      !modalClose ||
      !modalCloseBtn ||
      !modalBackdrop ||
      !prevButton ||
      !nextButton ||
      !modalTitle ||
      !loadingElement
    ) {
      return
    }

    let currentIndex = -1
    const mosaicItems = Array.from(
      document.querySelectorAll<HTMLElement>('.mosaic-item')
    )
    const getImagePath = (index: number): string =>
      mosaicItems[index]?.dataset.imagePath || ''

    // Warm the browser cache for the neighbours so prev/next feel instant
    const preloadAdjacentImages = (index: number): void => {
      ;[index - 1, index + 1].forEach((i) => {
        const src = getImagePath(i)
        if (src) new Image().src = src
      })
    }

    modalImage.onload = () => {
      loadingElement.style.display = 'none'
      modalImage.style.opacity = '1'
    }

    modalImage.onerror = () => {
      if (!modalImage.getAttribute('src')) return
      loadingElement.style.display = 'block'
      loadingElement.textContent = 'Failed to load image'
    }

    const updateModalContent = (index: number): void => {
      const imageUrl = getImagePath(index)
      if (!imageUrl) return

      loadingElement.style.display = 'block'
      loadingElement.textContent = 'Loading...'
      modalImage.style.opacity = '0'
      modalImage.src = imageUrl
      modalImage.alt = `Som & Toon, sweet moment ${index + 1} of ${mosaicItems.length}`

      modalTitle.textContent = `Photo ${index + 1} of ${mosaicItems.length}`
      currentIndex = index

      prevButton.disabled = index === 0
      nextButton.disabled = index === mosaicItems.length - 1

      preloadAdjacentImages(index)
    }

    const closeModal = (): void => {
      modal.classList.remove('active')
      document.body.style.overflow = ''
      // Return focus to the photo that opened the modal
      lastFocusedItem?.focus({ preventScroll: true })
      setTimeout(() => {
        modalImage.removeAttribute('src')
        currentIndex = -1
      }, 300)
    }

    const showPrevImage = (): void => {
      if (currentIndex > 0) updateModalContent(currentIndex - 1)
    }

    const showNextImage = (): void => {
      if (currentIndex < mosaicItems.length - 1) {
        updateModalContent(currentIndex + 1)
      }
    }

    modal.addEventListener('click', (e) => {
      const target = e.target as HTMLElement

      if (
        target === modalBackdrop ||
        target.closest('.image-modal-close') ||
        target.closest('.image-modal-close-btn')
      ) {
        closeModal()
      } else if (target.closest('.image-modal-prev')) {
        showPrevImage()
      } else if (target.closest('.image-modal-next')) {
        showNextImage()
      }
    })

    let lastFocusedItem: HTMLElement | null = null

    const openModal = (mosaicItem: HTMLElement): void => {
      const index = mosaicItems.indexOf(mosaicItem)
      if (index === -1) return

      lastFocusedItem = mosaicItem
      updateModalContent(index)
      modal.classList.add('active')
      document.body.style.overflow = 'hidden'

      // Focus the close button for accessibility
      modalClose.focus()
    }

    const mosaic = document.querySelector('.photo-mosaic')

    mosaic?.addEventListener('click', (e) => {
      const mosaicItem = (e.target as HTMLElement).closest<HTMLElement>(
        '.mosaic-item'
      )
      if (mosaicItem) openModal(mosaicItem)
    })

    // Items are role="button", so Enter and Space open them like a real button
    mosaic?.addEventListener('keydown', (e) => {
      const event = e as KeyboardEvent
      if (event.key !== 'Enter' && event.key !== ' ') return

      const mosaicItem = (event.target as HTMLElement).closest<HTMLElement>(
        '.mosaic-item'
      )
      if (!mosaicItem) return

      event.preventDefault()
      openModal(mosaicItem)
    })

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (!modal.classList.contains('active')) return

      if (e.key === 'Escape') {
        closeModal()
      } else if (e.key === 'ArrowLeft') {
        showPrevImage()
      } else if (e.key === 'ArrowRight') {
        showNextImage()
      }
    })
  }

  setupAnimations()
  setupHoverEffects()
  setupImageModal()
</script>
