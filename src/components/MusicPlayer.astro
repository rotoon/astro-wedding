<!-- Background music toggle; the audio element is created lazily by the script below -->
<div class='audio-control'>
  <button
    id='audio-toggle'
    class='audio-btn muted'
    type='button'
    aria-label='Background music'
    aria-pressed='false'
  >
    <svg
      class='audio-on'
      aria-hidden='true'
      viewBox='0 0 24 24'
      fill='none'
      stroke='currentColor'
      stroke-width='2'
      stroke-linecap='round'
      stroke-linejoin='round'
    >
      <polygon points='11 5 6 9 2 9 2 15 6 15 11 19 11 5'></polygon>
      <path d='M15.54 8.46a5 5 0 0 1 0 7.07'></path>
      <path d='M19.07 4.93a10 10 0 0 1 0 14.14'></path>
    </svg>
    <svg
      class='audio-off'
      aria-hidden='true'
      viewBox='0 0 24 24'
      fill='none'
      stroke='currentColor'
      stroke-width='2'
      stroke-linecap='round'
      stroke-linejoin='round'
    >
      <polygon points='11 5 6 9 2 9 2 15 6 15 11 19 11 5'></polygon>
      <line
        x1='23'
        y1='9'
        x2='17'
        y2='15'
      ></line>
      <line
        x1='17'
        y1='9'
        x2='23'
        y2='15'
      ></line>
    </svg>
  </button>
</div>

<script>
  const BGM_SRC = '/bgm/bgm.MP3'
  const BGM_VOLUME = 0.6
  // Events browsers count as user activation (allowed to start audio).
  // scroll and touchstart are not, so they would only download the file in vain.
  const ACTIVATION_EVENTS = ['click', 'touchend', 'keydown'] as const

  const toggleButton = document.getElementById('audio-toggle')

  // No src yet: nothing is downloaded until the guest's first interaction
  const bgm = new Audio()
  bgm.id = 'bgm-global'
  bgm.preload = 'none'
  bgm.loop = true
  bgm.volume = BGM_VOLUME
  bgm.style.display = 'none'
  document.body.appendChild(bgm)

  let started = false

  const updateButtonState = () => {
    if (!toggleButton) return
    const silent = bgm.muted || bgm.paused
    toggleButton.classList.toggle('muted', silent)
    toggleButton.setAttribute('aria-pressed', String(!silent))
  }

  const removeActivationListeners = () => {
    ACTIVATION_EVENTS.forEach((type) =>
      document.removeEventListener(type, onFirstInteraction)
    )
  }

  const play = () => {
    if (started) return
    if (!bgm.getAttribute('src')) bgm.src = BGM_SRC

    bgm
      .play()
      .then(() => {
        started = true
        removeActivationListeners()
      })
      .catch(() => {
        // Not allowed yet; keep listening for the next interaction
      })
  }

  function onFirstInteraction(event: Event) {
    // The toggle button handles its own presses. Otherwise touchend would start
    // the music and the following click on the button would mute it right away.
    if (event.target instanceof Element && event.target.closest('#audio-toggle')) {
      return
    }
    play()
  }

  const toggle = () => {
    // Before playback has ever started, a press means "turn the music on"
    if (!started && bgm.paused) {
      bgm.muted = false
      play()
    } else {
      bgm.muted = !bgm.muted
    }
    updateButtonState()
  }

  ACTIVATION_EVENTS.forEach((type) =>
    document.addEventListener(type, onFirstInteraction)
  )
  toggleButton?.addEventListener('click', toggle)

  // Keep the icon in sync with what is actually audible
  bgm.addEventListener('play', updateButtonState)
  bgm.addEventListener('pause', updateButtonState)
  bgm.addEventListener('volumechange', updateButtonState)
  updateButtonState()
</script>
