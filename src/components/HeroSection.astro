---
import { afterWedding, couple, dateParts } from '../data/wedding'

const heroAlt = `${couple.bride.nickname} and ${couple.groom.nickname} walking hand in hand on a hillside at sunset`
---

<div class='parallax-hero'>
  <!-- The first thing guests see: a real <img> (not a CSS background) so the
       browser finds it in the HTML, fetches it first and picks the size for the
       screen. The portrait photo covers the hero: on screens narrower than 2:3
       its width is 2/3 of the height. -->
  <img
    class='parallax-layer hero-bg'
    data-speed='0.2'
    src='/img/hero-1200.webp'
    srcset='/img/hero-800.webp 800w, /img/hero-1000.webp 1000w, /img/hero-1200.webp 1200w, /img/hero-1600.webp 1600w, /img/hero.webp 2000w'
    sizes='(max-aspect-ratio: 2/3) 67vh, 100vw'
    width='2000'
    height='3000'
    alt={heroAlt}
    fetchpriority='high'
  />
  <div
    class='parallax-layer hero-overlay'
    data-speed='0.1'
  >
  </div>
  <div class='parallax-content'>
    <div class='hero-date'>
      <div class='date-line'><span>{dateParts.day}</span></div>
      <div class='date-line'><span>{dateParts.month}</span></div>
      <div class='date-line'><span>{dateParts.year}</span></div>
    </div>
    <div class='hero-title'>
      <div class='heading-decorative'>{afterWedding.heroHeading}</div>
      <h1 class='main-title'>
        <span class='name-line-1'>{couple.bride.name}</span>
        <span class='name-separator'>&</span>
        <span class='name-line-2'>{couple.groom.name}</span>
      </h1>
    </div>
    <div class='scroll-indicator'>
      <span>Explore More</span>
      <div class='scroll-arrow'>
        <svg
          viewBox='0 0 24 24'
          width='24'
          height='24'
          stroke='currentColor'
          stroke-width='1'
          fill='none'
          stroke-linecap='round'
          stroke-linejoin='round'
        >
          <path d='M12 5v14M5 12l7 7 7-7'></path>
        </svg>
      </div>
    </div>
  </div>
  <div class='hero-ornamental-border'></div>
</div>

<script>
  import { throttle } from '../utils/throttle'

  const parallaxElements =
    document.querySelectorAll<HTMLElement>('.parallax-layer')
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches

  // RAF-based throttling: at most one transform update per frame
  const updateParallax = throttle(() => {
    const scrollTop = window.scrollY

    if (scrollTop <= window.innerHeight) {
      parallaxElements.forEach((element) => {
        const speed = parseFloat(element.getAttribute('data-speed') || '0')
        // The layers move down a little as the page scrolls up, so they lag
        // behind the content. Moving them up instead uncovered the bottom of
        // the hero (a bare strip under the photo while scrolling).
        const yPos = scrollTop * speed

        if (element.classList.contains('hero-bg')) {
          // Eases from the starting zoom towards 1, never below: smaller would
          // leave the edges of the hero uncovered
          const scale = Math.max(1, 1.1 - scrollTop * 0.0001)
          element.style.transform = `scale(${scale}) translateY(${yPos}px)`
        } else {
          element.style.transform = `translateY(${yPos}px)`
        }
      })
    }
  })

  if (!prefersReducedMotion) {
    window.addEventListener('scroll', updateParallax, { passive: true })

    // Starting position (zoomed in), applied once the photo has been painted at
    // its normal size: Chrome doesn't count an image larger than the viewport
    // as the page's main content (LCP), so it must not start zoomed. Written
    // without reading the scroll position (a read during page load forces an
    // extra layout); a page restored mid-scroll fires a scroll event instead.
    const heroImage = document.querySelector<HTMLImageElement>('.hero-bg')
    heroImage
      ?.decode()
      .catch(() => {})
      .then(() =>
        // Two frames: the first paints the photo, the second starts the zoom
        requestAnimationFrame(() =>
          requestAnimationFrame(() => heroImage.style.setProperty('transform', 'scale(1.1)'))
        )
      )
  }
</script>
