rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Guestbook photos: public read, upload-only images up to 5 MB
    match /wishes/{fileName} {
      allow read: if true;
      allow create: if
        request.resource.contentType.matches('image/.*') &&
        request.resource.size <= 5 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
